	measure 'Transaction rows' = SUM ( 'bi sales_daily'[transaction_row_count] )
		formatString: #,0
		lineageTag: b6011309-cb78-4287-a1e2-f58dbc3ba36d

	measure 'Transaction rows (exact)' = FORMAT ( [Transaction rows], "#,0", "en-US" )
		lineageTag: 57de3a53-2460-468b-bbf6-01cfc5bbe86f

	measure 'Missing customer ID rows' = SUM ( 'bi sales_daily'[missing_customer_id_row_count] )
		formatString: #,0
