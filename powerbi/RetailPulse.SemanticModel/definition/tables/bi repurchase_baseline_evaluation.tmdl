table 'bi repurchase_baseline_evaluation'
	lineageTag: 1ad74031-eac5-481a-8f98-f24f6ae88341

	measure 'Baseline precision' =
			DIVIDE (
				SUM ( 'bi repurchase_baseline_evaluation'[true_positive_count] ),
				SUM ( 'bi repurchase_baseline_evaluation'[predicted_repurchase_customer_count] )
			)
		formatString: 0.0%
		lineageTag: 0e766255-e451-45d3-a451-e19057853ee9

	measure 'Baseline recall' =
			DIVIDE (
				SUM ( 'bi repurchase_baseline_evaluation'[true_positive_count] ),
				SUM ( 'bi repurchase_baseline_evaluation'[actual_repurchase_customer_count] )
			)
		formatString: 0.0%
		lineageTag: 0929d50f-232e-4dd1-beb3-29cf478392c6

	measure 'Baseline accuracy' =
			DIVIDE (
				SUM ( 'bi repurchase_baseline_evaluation'[correct_prediction_count] ),
				SUM ( 'bi repurchase_baseline_evaluation'[labeled_customer_count] )
			)
		formatString: 0.0%
		lineageTag: fd6c665d-7d76-4a57-ad79-b432880ec4f5

	measure 'Labeled customers' = SUM ( 'bi repurchase_baseline_evaluation'[labeled_customer_count] )
		formatString: #,0
		lineageTag: e81b2a93-5c31-4e8a-8101-112233445566

	measure 'Repurchase base rate' =
			DIVIDE (
				SUM ( 'bi repurchase_baseline_evaluation'[actual_repurchase_customer_count] ),
				SUM ( 'bi repurchase_baseline_evaluation'[labeled_customer_count] )
			)
		formatString: 0.0%
		lineageTag: 78852cb0-9985-4be7-95a6-5f7a6c76dc22

