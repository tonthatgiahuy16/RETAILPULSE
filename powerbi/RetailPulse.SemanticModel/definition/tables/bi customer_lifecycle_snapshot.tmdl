table 'bi customer_lifecycle_snapshot'
	lineageTag: 978098c9-e21f-47c9-a108-e5bb610727df

	measure Customers = DISTINCTCOUNT ( 'bi customer_lifecycle_snapshot'[customer_id] )
		formatString: #,0
		lineageTag: e0449bf3-b539-441d-84ec-3e53c01a7c98

	measure 'Illustrative capacity customers' =
			CALCULATE (
				[Customers],
				'bi customer_lifecycle_snapshot'[is_within_illustrative_budget] = TRUE ()
			)
		formatString: #,0
		lineageTag: f368733b-4f32-408e-9dfd-285e026ac918

	measure 'Champions count' =
			CALCULATE (
				[Customers],
				'bi customer_lifecycle_snapshot'[priority_segment] = "CHAMPIONS"
			)
		formatString: #,0
		lineageTag: b82c7a91-4e12-4c6e-8211-123456789abc

	measure 'At-risk high-value count' =
			CALCULATE (
				[Customers],
				'bi customer_lifecycle_snapshot'[priority_segment] = "AT_RISK_HIGH_VALUE"
			)
		formatString: #,0
		lineageTag: c93d8b02-5f23-4d7f-9322-987654321def

	measure 'Monetary spend (£)' = SUM ( 'bi customer_lifecycle_snapshot'[monetary_amount] )
		formatString: #,0.00
		lineageTag: d74e9c13-6a34-4e8a-8433-112233445577

