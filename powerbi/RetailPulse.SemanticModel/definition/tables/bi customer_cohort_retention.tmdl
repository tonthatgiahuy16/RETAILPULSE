table 'bi customer_cohort_retention'
	lineageTag: 66305a7c-f67d-4b42-a3f5-bfeedaa6aa7b

	measure 'Weighted retention rate' =
			DIVIDE (
				SUM ( 'bi customer_cohort_retention'[retained_customer_count] ),
				SUM ( 'bi customer_cohort_retention'[cohort_customer_count] )
			)
		formatString: 0.0%
		lineageTag: cb42b139-340b-4d7e-b275-42330dab84d3

