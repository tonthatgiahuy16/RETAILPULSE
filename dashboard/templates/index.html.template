    <!-- Lightweight interaction for the 3 discrete budget levels -->
    <script>
      const budgetData = {{BUDGET_DATA_JSON}};

      function setBudget(fraction, btn) {
        document.querySelectorAll('.btn-pill').forEach(el => el.classList.remove('active'));
        btn.classList.add('active');

        const d = budgetData[fraction];
        if (!d) return;
        document.getElementById('budget-label').textContent = d.label;
        document.getElementById('fb-count').textContent = d.fbCount;
        document.getElementById('fb-precision').textContent = d.fbPrecision;
        document.getElementById('fb-recall').textContent = d.fbRecall;
        document.getElementById('fb-lift').textContent = d.fbLift;
        document.getElementById('fb-diff').textContent = d.fbDiff;
        document.getElementById('fb-ci').textContent = d.fbCi;
        document.getElementById('lr-count').textContent = d.lrCount;
        document.getElementById('lr-precision').textContent = d.lrPrecision;
        document.getElementById('lr-recall').textContent = d.lrRecall;
        document.getElementById('lr-lift').textContent = d.lrLift;
      }
    </script>
