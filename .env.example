# Copy the variable names into your shell or a local secret manager. This file
# is documentation only; do not add real passwords, tokens, or DSNs to Git.

# Required by pipeline, DAG, ingestion, and model-validation commands.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>

# Required only to enable PostgreSQL integration tests. Point this at a
# disposable database because the tests reset project schemas.
RETAILPULSE_INTEGRATION_TEST=1
RETAILPULSE_INTEGRATION_DSN=postgresql://<test-user>:<test-password>@127.0.0.1:55432/<test-database>

# Required only by dbt. Keep the password in your shell or secret manager.
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=<user>
DBT_PASSWORD=<password>
DBT_DATABASE=<database>

# Optional failure notification for the DAG runner.
RETAILPULSE_ALERT_WEBHOOK=
